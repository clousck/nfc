[Unit]
Description=Backup de la base SQLite del admin NFC a /mnt/usb
RequiresMountsFor=/mnt/usb

[Service]
Type=oneshot
# Opcional: DB_PATH, RETENTION_DAYS, D1_EXPORT, CLOUDFLARE_API_TOKEN, etc.
EnvironmentFile=-/etc/nfc-backup.env
# Solo copiar si lo montado en /mnt/usb es la USB de backups.
Environment=BACKUP_LABEL=pi-usb
# Ruta del repo clonado en la Pi.
ExecStart=/home/victorees/nfc-platform/infra/backup.sh
Nice=10
IOSchedulingClass=idle
