# --- apps/admin (Raspberry Pi) ---
# Copiar a .env en el stack de Dockge. Nunca commitear el .env real.

PORT=3000
DATABASE_PATH=/data/admin.db
# URL pública del Worker (se graba en el chip y en el QR)
PUBLIC_BASE_URL=https://go.penginexr.com

# Cloudflare API — token con permisos mínimos:
#   Workers KV Storage:Edit y D1:Read sobre los recursos del proyecto
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_LINKS_NAMESPACE_ID=
CF_D1_DATABASE_ID=

# Túnel propio del stack (Zero Trust → Networks → Tunnels → el túnel "nfc" → token)
TUNNEL_TOKEN=

# Cloudflare Access (valida Cf-Access-Jwt-Assertion)
#   CF_ACCESS_TEAM_DOMAIN=<equipo>.cloudflareaccess.com
#   CF_ACCESS_AUD=<Application Audience (AUD) tag>
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Solo para desarrollo local: desactiva la validación de Access
AUTH_DISABLED=false
