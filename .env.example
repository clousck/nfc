# --- apps/admin (Raspberry Pi) ---
# Copiar a .env en el stack de Dockge. Nunca commitear el .env real.

PORT=3000
DATABASE_PATH=/data/admin.db
# URL pública del Worker (se graba en el chip y en el QR)
PUBLIC_BASE_URL=https://go.penginexr.com

# API interna del Worker (/internal/*). El mismo valor va como secreto del Worker
# (Cloudflare → Workers → nfc-edge → Settings → Variables and Secrets → INTERNAL_API_TOKEN).
# Mínimo 32 caracteres. Generarlo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Sin él, el panel funciona pero los cambios esperan en la cola de publicación.
INTERNAL_API_TOKEN=
# Opcional: URL del Worker si no es PUBLIC_BASE_URL (en desarrollo: http://127.0.0.1:8787)
# EDGE_URL=

# Túnel propio del stack (Zero Trust → Networks → Tunnels → el túnel "nfc" → token)
TUNNEL_TOKEN=

# Cloudflare Access (valida Cf-Access-Jwt-Assertion)
#   CF_ACCESS_TEAM_DOMAIN=<equipo>.cloudflareaccess.com
#   CF_ACCESS_AUD=<Application Audience (AUD) tag>
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Solo para desarrollo local: desactiva la validación de Access
AUTH_DISABLED=false
